const LICENSES_JSON_PATH = path.join(__dirname, 'licenses.json');

function registerNewLicense(key, level, ownerName) {
    let licenses = {};
    if (fs.existsSync(LICENSES_JSON_PATH)) {
        licenses = JSON.parse(fs.readFileSync(LICENSES_JSON_PATH, 'utf-8'));
    }
    
    licenses[key] = {
        level: level.toUpperCase(),
        status: "active",
        owner: ownerName
    };
    
    fs.writeFileSync(LICENSES_JSON_PATH, JSON.stringify(licenses, null, 2), 'utf-8');
}